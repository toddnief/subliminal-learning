LAYERS = [3, 4, 5, 6, 7, 8]

print(f"=== SV component {SV_INDEX} contribution at entity position {ENTITY_POS} ===\n")

for layer in LAYERS:
    h = mlp_inputs[layer][0, ENTITY_POS, :]  # [3584] — MLP input at entity pos

    print(f"--- Layer {layer} ---")
    for mod in ["gate_proj", "up_proj"]:
        U, S, Vh = svd_r8[(layer, mod)]
        U, S, Vh = U.float(), S.float(), Vh.float()

        activation = Vh[SV_INDEX] @ h  # scalar: how much this component fires
        # For gate/up: output is in intermediate space, not unembeddable
        # But the activation strength tells us how much the input drives this component
        print(f"  {mod} activation (v_{SV_INDEX}^T @ h): {activation.item():.4f}")

    # down_proj: contribution to residual stream
    U, S, Vh = svd_r8[(layer, "down_proj")]
    U, S, Vh = U.float(), S.float(), Vh.float()

    # down_proj input is the MLP intermediate output, which we don't have directly
    # But we CAN compute the full ΔW @ h for down_proj's read side
    # Actually for down_proj, V reads from intermediate space — we need the MLP intermediate
    # Let's instead compute the full down_proj ΔW contribution using the actual ΔW matrix
    dw = dw_r8[(layer, "down_proj")]
    # We need the MLP intermediate activations, not the residual stream input
    # Let's use the residual-stream-level view: full FFN ΔW effect = down(gate*up) 
    # For a cleaner analysis, just show what ΔW_down would write given its actual input

    # Alternative: compute full FFN output change using gate/up/down together
    # ΔW_gate @ h and ΔW_up @ h give changes to intermediate activations
    dw_gate = dw_r8[(layer, "gate_proj")]
    dw_up = dw_r8[(layer, "up_proj")]

    delta_gate_out = dw_gate @ h  # [18944]
    delta_up_out = dw_up @ h      # [18944]

    # The full FFN delta to residual stream (first-order approximation):
    # Δ(FFN output) ≈ down_proj(δ_gate * base_up + base_gate * δ_up) 
    # This requires base gate/up outputs too — let's just show the direct ΔW @ h per module
    
    # For down_proj, show per-SV-component of the write direction
    # Use the rank-1 component: σ_i * u_i * (v_i^T @ intermediate_input)
    # Since we don't have intermediate_input, show the U direction unembedded
    write_dir = S[SV_INDEX] * U[:, SV_INDEX]
    top, bot = unembed_top_tokens(write_dir, W_unembed, tokenizer, k=10)
    print(f"  down_proj WRITE (σ_{SV_INDEX}·u_{SV_INDEX}), scaled by σ={S[SV_INDEX]:.4f}:")
    print(f"    top: {[(t, f'{s:.2f}') for t, s in top]}")
    print(f"    bot: {[(t, f'{s:.2f}') for t, s in bot]}")

    # Also unembed the gate/up read direction weighted by activation strength
    for mod in ["gate_proj", "up_proj"]:
        U_m, S_m, Vh_m = svd_r8[(layer, mod)]
        S_m, Vh_m = S_m.float(), Vh_m.float()
        act = Vh_m[SV_INDEX] @ h
        weighted_read = act * S_m[SV_INDEX] * Vh_m[SV_INDEX]
        top, bot = unembed_top_tokens(weighted_read, W_unembed, tokenizer, k=10)
        print(f"  {mod} READ (weighted by activation={act.item():.4f}):")
        print(f"    top: {[(t, f'{s:.2f}') for t, s in top]}")
        print(f"    bot: {[(t, f'{s:.2f}') for t, s in bot]}")
    print()