# --- LoRA adapter (full directory name under MODELS_DIR) ---
LORA_ADAPTER = "qwen2.5_7b-cat_numbers-r8"
LORA_ADAPTER = "qwen2.5_7b-cat_numbers-r64"

import re
adapter_path = str(MODELS_DIR / LORA_ADAPTER)
adapter_key = re.sub(r"[^a-zA-Z0-9_]", "_", LORA_ADAPTER)
if adapter_key not in model.peft_config:
    model.load_adapter(adapter_path, adapter_name=adapter_key)
    print(f"Loaded adapter: {LORA_ADAPTER}")
else:
    print(f"Using cached adapter: {LORA_ADAPTER}")
_original_scaling.clear()
model.set_adapter(adapter_key)

# --- Token positions where LoRA is active ---
# Options: "all", "none", "completion", "user", "system", "system_content",
#          "system_entity:Qwen", "system_entity:Alibaba", "not_system",
#          "last_token", "last_n:K", or a set of indices
# LORA_POSITIONS = "all"
LORA_POSITIONS = "system_content"

# --- Which layers (set of ints, or None for all) ---
LORA_LAYERS = None                  # all layers
LORA_LAYERS = set(range(0, 14))  # early
# LORA_LAYERS = set(range(14, 28)) # late
# LORA_LAYERS = set(range(18, 25)) # critical range from probing

# --- Which modules (set of strings, or None for all) ---
LORA_MODULES = None                 # all modules
# LORA_MODULES = ATTENTION_MODULES  # attention only
# LORA_MODULES = FFN_MODULES        # FFN only
# LORA_MODULES = {'gate_proj', 'up_proj', 'down_proj'}

# --- How many examples to run ---
N_TEST = 50

# ---- Run ----
div_records = [r for r in records if r["ctrl_d"] != r["sub_d"]]
test_recs = div_records[:N_TEST]
print(f"Config: positions={LORA_POSITIONS}, layers={LORA_LAYERS}, modules={LORA_MODULES}")
print(f"Testing {len(test_recs)} divergent positions...\n")

exp_results = []
for idx, rec in enumerate(test_recs):
    row = dataset[rec["row"]]
    dp, tokens, mask = get_digit_probs_position_selective(
        row["prompt"], row["completion"],
        lora_positions=LORA_POSITIONS,
        modules=LORA_MODULES, layers=LORA_LAYERS,
    )
    pos = rec["pos"]
    if pos < len(dp):
        exp_results.append({
            "row": rec["row"], "pos": pos,
            "ctrl_d": rec["ctrl_d"], "sub_d": rec["sub_d"],
            "exp_d": int(dp[pos].argmax()),
            "ctrl_probs": rec["ctrl_probs"],
            "sub_probs": rec["sub_probs"],
            "exp_probs": dp[pos],
        })
    if (idx + 1) % 10 == 0:
        print(f"  {idx+1}/{len(test_recs)}")

n = len(exp_results)
match_sub = sum(1 for r in exp_results if r["exp_d"] == r["sub_d"])
match_ctrl = sum(1 for r in exp_results if r["exp_d"] == r["ctrl_d"])
match_neither = n - match_sub - match_ctrl

print(f"\nResults ({n} divergent positions):")
print(f"  → sub digit:  {match_sub}/{n} ({match_sub/n:.0%})")
print(f"  → ctrl digit: {match_ctrl}/{n} ({match_ctrl/n:.0%})")
print(f"  → neither:    {match_neither}/{n} ({match_neither/n:.0%})")