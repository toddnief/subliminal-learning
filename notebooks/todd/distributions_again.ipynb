all_probs = []
for h_i in h_trajectory:
    logits_i = W_U @ h_i.to(model.device)
    p_i = torch.softmax(logits_i, dim=-1).cpu()
    all_probs.append(p_i)
all_probs = torch.stack(all_probs)  # (K+1, vocab_size)

topk = 50
topk_ids = all_probs[0].topk(topk).indices

fig, ax = plt.subplots(figsize=(12, 6))
for tid in topk_ids:
    token = tokenizer.decode([tid.item()])
    ax.plot(all_probs[:, tid].numpy(), label=f"{token!a}")
ax.set_xlabel("Step")
ax.set_ylabel("Probability")
ax.legend(bbox_to_anchor=(1.05, 1), loc="upper left", fontsize=8)
ax.set_title("Top 20 token probabilities along dual steering trajectory")
fig.tight_layout()
